a = [3 2 -1 4 2 -2 1 0 5 1 3 2];
results1 = [];
for shift1 = 0:length(a)-1
    % Циклический сдвиг
    a_shift1 = zeros(1, length(a));
    [c, lags] = xcorr(a, 'normalized');


results = [];
for shift = 0:length(a)-1
    % Циклический сдвиг
    a_shift = zeros(1, length(a));
    for i = 1:length(a)
        new_pos = mod(i - 1 - shift, length(a)) + 1;
        a_shift(i) = a(new_pos);
    end
    
    % Автокорреляция
    corr = sum(a .* a_shift);
    norm_corr = corr / (sqrt(sum(a.^2)) * sqrt(sum(a_shift.^2)));
    results = [results, norm_corr];
end

fprintf('Встроенная функция (лаг 0): %.4f\n', c(lags == 1));
fprintf('автокорреляция (сдвиг 0):  %.4f\n', results());

figure;
subplot(2,1,1);
stem(lags, c, 'filled');
title('Встроенная функция xcorr');
xlabel('Сдвиг'); ylabel('Корреляция');

subplot(2,1,2);
stem(0:length(a)-1, results, 'filled');
title('автокорреляция');
xlabel('Сдвиг'); ylabel('Корреляция');